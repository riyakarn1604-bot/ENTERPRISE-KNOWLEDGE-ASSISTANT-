# Create a copy of this file named `.env` and fill in your keys.

# Optional: If provided, OpenAI gpt-4o-mini will be used for generation and evaluation.
# If NOT provided, the system will download and run TinyLlama/TinyLlama-1.1B-Chat-v1.0 locally (requires ~2GB disk/RAM).
OPENAI_API_KEY=your_openai_api_key_here
